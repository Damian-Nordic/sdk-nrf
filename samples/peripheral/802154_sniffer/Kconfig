mainmenu "IEEE 802.15.4 Sniffer sample"

config IEEE802154_SNIFFER_TIME_SYNC
	bool "Hardware GPIO time synchronization"
	select NRFX_GPIOTE
	select NRFX_GPPI
	select NRFX_TIMER
	default y if $(dt_nodelabel_enabled,sniffer_sync)
	default n
	help
	  Enable GPIOTE + PPI + GRTC/RTC capture based time sync between
	  multiple sniffer devices. Requires sniffer_sync devicetree node.

config IEEE802154_SNIFFER_SYNC_INTERVAL_MS
	int "Master sync pulse interval (ms)"
	default 100
	depends on IEEE802154_SNIFFER_TIME_SYNC
	help
	  Interval between master sync pulses.

config IEEE802154_SNIFFER_SYNC_PULSE_US
	int "Master sync pulse width (us)"
	default 10
	depends on IEEE802154_SNIFFER_TIME_SYNC
	help
	  Width of the master sync pulse before the pin is cleared.

source "Kconfig.zephyr"
